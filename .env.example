# AERIS 2.0 Environment Configuration

# Database
# Default: Local SQLite (aeris2.db)
DATABASE_URL=sqlite:///./aeris2.db
# PostgreSQL / Supabase format:
# DATABASE_URL=postgresql+psycopg2://aeris:password@localhost:5432/aeris_sentinel

# Security & Tokens
JWT_SECRET=aeris_sentinel_super_secret_jwt_key_2026_northeast_surveillance
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Anti-Fake Telemetry Salt
ID_HASH_SALT=aeris_northeast_surveillance_verhoeff_salt_2026
MAX_GEO_DISCREPANCY_KM=15.0
DUPLICATE_WINDOW_HOURS=24
